rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/assignments/{assignmentId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupMemberAfter(groupId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function isGroupOwner(groupId) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (
          (
            request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds)
          ) || (
            resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.auth.uid != resource.data.createdBy
          )
        );
      allow delete: if isGroupOwner(groupId);

      match /assignments/{assignmentId} {
        allow read, create, update: if isGroupMember(groupId);
        allow delete: if isGroupOwner(groupId);

        match /completions/{userId} {
          allow read: if isGroupMember(groupId);
          allow create, update: if isGroupMember(groupId) && signedIn() && request.auth.uid == userId;
          allow delete: if isGroupOwner(groupId) || (isGroupMember(groupId) && request.auth.uid == userId);
        }
      }

      match /members/{userId} {
        allow read: if isGroupMember(groupId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.userId == userId
          && (isGroupMember(groupId) || isGroupMemberAfter(groupId));
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName'])
          && request.resource.data.userId == userId;
        allow delete: if isGroupOwner(groupId) || (signedIn() && request.auth.uid == userId);
      }
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.createdBy == request.auth.uid;
    }
  }
}
